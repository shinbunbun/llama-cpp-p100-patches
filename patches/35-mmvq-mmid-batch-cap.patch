+int ggml_cuda_mmvq_mmid_override() {
+    static const int ov = [] {
+        const char * e = getenv("LLAMA_MMVQ_MMID_MAX");
+        const int v = e ? atoi(e) : 0;
+        // one block is warp_size x ncols_dst threads, and 32 is the widest instantiation
+        const int ws = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+        return v > 0 ? std::min(std::min(v, 32), 1024/ws) : 0;
+    }();
+    return ov;
+}
+
+int ggml_cuda_mmvq_mmid_cap() {
+    const int ov = ggml_cuda_mmvq_mmid_override();
+    return ov > MMVQ_MAX_BATCH_SIZE ? ov : MMVQ_MAX_BATCH_SIZE;
+}
