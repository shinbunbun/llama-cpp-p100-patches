+        const int64_t s2 = ne00*ne01*ne02;
+        const int64_t d2 = ne10*ne11*ne12;
+        if (ne <= INT_MAX && s2 <= UINT_MAX && d2 <= UINT_MAX && s2 > 0 && d2 > 0) {
