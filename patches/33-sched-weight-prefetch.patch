+void ggml_backend_sched_clear_staging_area(ggml_backend_buffer_t buffer) {
+    if (g_stage_buf == buffer) {
+        g_stage_buf  = NULL;
+        g_stage_size = 0;
+    }
+}
+
+uint64_t ggml_backend_sched_staging_epoch(size_t * extent) {
+    if (extent) {
+        *extent = g_stage_extent.load();
+    }
+    return g_stage_epoch.load();
+}
+
+static bool sched_is_offloaded_weight(ggml_backend_sched_t sched, const struct ggml_backend_sched_split * split, int backend_id, struct ggml_tensor * input) {
+    if (split->graph.n_nodes == 0 || !input->buffer || (input->flags & GGML_TENSOR_FLAG_INPUT) ||
+        ggml_backend_buffer_get_usage(input->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS || !ggml_backend_buffer_is_host(input->buffer)) {
+        return false;
+    }
+    const ggml_tensor * node = split->graph.nodes[0];
+    return node->op == GGML_OP_MUL_MAT_ID && node->src[0] == tensor_copy(input, backend_id, sched->cur_copy);
+}
+
+static void sched_wpf_view(ggml_backend_sched_t sched, const ggml_tensor * like, size_t off, ggml_tensor * out) {
+    *out = *like;
+    out->op       = GGML_OP_NONE;
+    out->view_src = NULL;
+    out->view_offs = 0;
+    out->extra    = NULL;
+    for (int i = 0; i < GGML_MAX_SRC; ++i) {
+        out->src[i] = NULL;
+    }
+    out->buffer = sched->wpf_buf;
+    out->data   = (char *) ggml_backend_buffer_get_base(sched->wpf_buf) + off;
+}
+
+static bool sched_wpf_ready(ggml_backend_sched_t sched, ggml_backend_t gpu) {
+    if (!sched->wpf_tried) {
+        sched->wpf_tried = true;
+        const char * e = getenv("LLAMA_SCHED_WPF");
+        sched->wpf_size = e ? (size_t) atoll(e) << 20 : 0;
+        if (sched->wpf_size) {
+            ggml_backend_dev_t dev = ggml_backend_get_device(gpu);
+            sched->wpf_backend = ggml_backend_dev_init(dev, NULL);
+            if (g_stage_buf && ggml_backend_buffer_get_type(g_stage_buf) == ggml_backend_get_default_buffer_type(gpu)) {
+                sched->wpf_size = std::min(sched->wpf_size, g_stage_size);
+                sched->wpf_buf  = g_stage_buf;
+            } else {
+                sched->wpf_buf  = sched->wpf_backend ? ggml_backend_buft_alloc_buffer(ggml_backend_get_default_buffer_type(gpu), sched->wpf_size) : NULL;
+            }
+            sched->wpf_ev_up   = ggml_backend_event_new(dev);
+            sched->wpf_ev_free = ggml_backend_event_new(dev);
+            if (!sched->wpf_backend || !sched->wpf_buf || !sched->wpf_ev_up || !sched->wpf_ev_free) {
+                GGML_LOG_WARN("%s: weight prefetch disabled\n", __func__);
+                sched->wpf_size = 0;
+            } else if (sched->wpf_buf == g_stage_buf) {
+                g_stage_producer = sched->wpf_backend;
+            }
+        }
+    }
+    return sched->wpf_size > 0;
+}
+
+// the input was uploaded ahead of time: bring it over from the staging area instead of the host
+static bool sched_wpf_take(ggml_backend_sched_t sched, ggml_backend_t backend, struct ggml_tensor * input, struct ggml_tensor * input_cpy) {
+    if (ggml_backend_get_device(backend) != ggml_backend_get_device(sched->wpf_backend)) {
+        return false;
+    }
+    for (int i = 0; i < sched->wpf_n; ++i) {
+        if (sched->wpf_src[i] != input || sched->wpf_done[i]) {
+            continue;
+        }
+        ggml_backend_event_wait(backend, sched->wpf_ev_up);
+        struct ggml_tensor v;
+        sched_wpf_view(sched, input, sched->wpf_off[i], &v);
+        ggml_backend_tensor_copy_async(backend, backend, &v, input_cpy);
+        sched->wpf_done[i] = true;
+        bool all = true;
+        for (int j = 0; j < sched->wpf_n; ++j) {
+            all = all && sched->wpf_done[j];
+        }
+        if (all) {
+            ggml_backend_event_record(sched->wpf_ev_free, backend);
+            sched->wpf_n = 0;
+        }
+        return true;
+    }
+    return false;
+}
+
+// called after split_id was queued: stage the offloaded weights of the splits that follow
+static void sched_wpf_stage(ggml_backend_sched_t sched, struct ggml_backend_sched_split * splits, int split_id) {
+    if (sched->wpf_n > 0) {
+        return;
+    }
+    size_t off = 0;
+    for (int j = split_id + 1; j < sched->n_splits && sched->wpf_n < 8; ++j) {
+        struct ggml_backend_sched_split * sp = &splits[j];
+        for (int k = 0; k < sp->n_inputs; ++k) {
+            struct ggml_tensor * in = sp->inputs[k];
+            if (!sched_is_offloaded_weight(sched, sp, sp->backend_id, in) ||
+                    ggml_backend_get_device(sched->backends[sp->backend_id]) != ggml_backend_get_device(sched->wpf_backend)) {
+                continue;
+            }
+            const size_t sz = GGML_PAD(ggml_nbytes(in), 256);
+            if (off + sz > sched->wpf_size || sched->wpf_n == 8) {
+                goto done;
+            }
+            sched->wpf_src[sched->wpf_n]  = in;
+            sched->wpf_off[sched->wpf_n]  = off;
+            sched->wpf_done[sched->wpf_n] = false;
+            sched->wpf_n++;
+            off += sz;
+        }
+    }
+done:
+    if (sched->wpf_n == 0) {
+        return;
+    }
+    if (sched->wpf_buf == g_stage_buf) {
+        size_t ext = g_stage_extent.load();
+        while (ext < off && !g_stage_extent.compare_exchange_weak(ext, off)) {
+        }
+        g_stage_epoch++;
+    }
+    ggml_backend_event_wait(sched->wpf_backend, sched->wpf_ev_free);
+    for (int i = 0; i < sched->wpf_n; ++i) {
+        struct ggml_tensor v;
+        sched_wpf_view(sched, sched->wpf_src[i], sched->wpf_off[i], &v);
+        ggml_backend_tensor_set_async(sched->wpf_backend, &v, sched->wpf_src[i]->data, 0, ggml_nbytes(sched->wpf_src[i]));
+    }
+    ggml_backend_event_record(sched->wpf_ev_up, sched->wpf_backend);
+}
