+void ggml_backend_sched_set_staging_area(ggml_backend_buffer_t buffer, size_t size) {
+    g_stage_buf  = buffer;
+    g_stage_size = buffer ? std::min(size, ggml_backend_buffer_get_size(buffer)) : 0;
