+// Quantized K/V are converted to F16 for the tile kernel. Converting the whole KV cache at once
+// needs 4 bytes per token per KV column of scratch, and ggml-alloc sizes it at graph reservation
+// for the maximum context: 4 KiB/token for a 4-head x 256 KV, 320 MiB at ctx 81920 and 1,024 MiB
+// at 262144, paid whether the context is used or not. Converting in chunks of this many tokens
+// and merging the partial results bounds the scratch by the chunk (64 MiB at 16k) instead.
+//
+// Measured on P100 with a 27B model (16 attention layers, q4_0 KV, ubatch 128), CUDA0 compute
+// buffer: ctx 81920 360 -> 104 MiB, ctx 262144 1,152 -> 192 MiB. Prefill at 40k/66k depth
+// 90.6 -> 88.6 / 82.6 -> 81.3 t/s (the merge launches), decode unchanged (vec kernel). At ctx
+// 262144 the 960 MiB let 6 more 170 MiB SSM blocks stay on the GPU: decode 11k 8.36 -> 11.04,
+// 40k 7.47 -> 9.54, 210k 4.33 -> 4.93 t/s. test-backend-ops FLASH_ATTN_EXT 2938/2938 at chunk
+// 256 (290 cases chunked) and at the default. Output is not bit-identical once the KV exceeds
+// the chunk (softmax merge order); below it the code path is the original one.
+// Neither the mma kernel (stream-k, Turing and later) nor the sparse-fa path (DSV4/GLM, which
+// compacts the mask to a KV subset before the kernel even runs) is chunked; both keep the
+// full-size scratch. Combining chunking with sparse compaction is not attempted: this host never
+// exercises sparse-fa, and there is no model on hand to validate the combination is correct.
+// GGML_CUDA_FA_F16_KV_CHUNK overrides the chunk (tokens, rounded up to FATTN_KQ_STRIDE); 0 disables chunking.
+static inline int64_t ggml_cuda_flash_attn_ext_f16_kv_chunk() {
+    static const int64_t chunk = []() -> int64_t {
+        const char * env = getenv("GGML_CUDA_FA_F16_KV_CHUNK");
+        const int64_t v = env ? atoll(env) : 16384;
+        if (v <= 0) {
+            return INT64_MAX;
+        }
+        return ((v + FATTN_KQ_STRIDE - 1) / FATTN_KQ_STRIDE) * FATTN_KQ_STRIDE;
+    }();
+    return chunk;
+}
