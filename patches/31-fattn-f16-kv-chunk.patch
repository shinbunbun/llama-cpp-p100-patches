+// Merge the parallel-block partials of one KV chunk into the running (unnormalized VKQ, KQ max, KQ sum)
+// accumulator; the last chunk writes the normalized result. Same math as flash_attn_combine_results.
+template<int D> // D == head size
+__launch_bounds__(D, 1)
+static __global__ void flash_attn_merge_kv_chunk(
+        const float  * VKQ_parts_ptr,
+        const float2 * VKQ_meta_ptr,
+        float  * acc_ptr,
+        float2 * acc_meta_ptr,
+        float  * dst_ptr,
+        const int parallel_blocks,
+        const bool first,
+        const bool last) {
+    ggml_cuda_pdl_lc();
+    const float  * GGML_CUDA_RESTRICT VKQ_parts = VKQ_parts_ptr;
+    const float2 * GGML_CUDA_RESTRICT VKQ_meta  = VKQ_meta_ptr;
+    float        * GGML_CUDA_RESTRICT acc       = acc_ptr;
+    float2       * GGML_CUDA_RESTRICT acc_meta  = acc_meta_ptr;
+    float        * GGML_CUDA_RESTRICT dst       = dst_ptr;
+
+    const int ne01 = gridDim.x;
+    const int ne02 = gridDim.y;
+
+    const int col      = blockIdx.x;
+    const int head     = blockIdx.y;
+    const int sequence = blockIdx.z;
+
+    const int j_dst_unrolled = (sequence*ne01 + col)*ne02 + head;
+
+    VKQ_parts += j_dst_unrolled * parallel_blocks*D;
+    VKQ_meta  += j_dst_unrolled * parallel_blocks;
+    acc       += j_dst_unrolled *                 D;
+    acc_meta  += j_dst_unrolled;
+    dst       += j_dst_unrolled *                 D;
+
+    const int tid = threadIdx.x;
+    __builtin_assume(tid < D);
+
+    extern __shared__ float2 meta[];
+    ggml_cuda_pdl_sync();
+    for (int i = tid; i < 2*parallel_blocks; i += D) {
+        ((float *) meta)[i] = ((const float *)VKQ_meta) [i];
+    }
+
+    __syncthreads();
+
+    float kqmax = meta[0].x;
+    for (int l = 1; l < parallel_blocks; ++l) {
+        kqmax = max(kqmax, meta[l].x);
+    }
+
+    float VKQ_numerator   = 0.0f;
+    float VKQ_denominator = 0.0f;
+    for (int l = 0; l < parallel_blocks; ++l) {
+        const float KQ_max_scale = expf(meta[l].x - kqmax);
+
+        VKQ_numerator   += KQ_max_scale * VKQ_parts[l*D + tid];
+        VKQ_denominator += KQ_max_scale * meta[l].y;
+    }
+
+    if (!first) {
+        const float2 prev = *acc_meta;
+        const float  kqmax_new = max(prev.x, kqmax);
+        const float  scale_prev = expf(prev.x - kqmax_new);
+        const float  scale_cur  = expf(kqmax - kqmax_new);
+
+        VKQ_numerator   = scale_prev*acc[tid] + scale_cur*VKQ_numerator;
+        VKQ_denominator = scale_prev*prev.y   + scale_cur*VKQ_denominator;
+        kqmax = kqmax_new;
+    }
+
+    if (last) {
+        dst[tid] = VKQ_numerator / VKQ_denominator;
+        return;
+    }
+
+    __syncthreads();
+    acc[tid] = VKQ_numerator;
+    if (tid == 0) {
+        *acc_meta = make_float2(kqmax, VKQ_denominator);
+    }
+}
