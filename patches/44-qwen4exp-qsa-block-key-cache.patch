+llama_memory_hybrid_idx::qsa_cache_plan llama_memory_hybrid_idx::qsa_plan(const llama_ubatch & ubatch, uint32_t ratio) const {
+    qsa_cache_plan plan;
+
+    if (qsa_pooled_map.empty() || ubatch.n_seqs_unq != 1 || ubatch.seq_id_unq[0] != 0) {
+        return plan;
+    }
+
+    const auto & cells = mem_idx->get_cells(0);
+
+    for (llama_seq_id s = 1; s < LLAMA_MAX_SEQ; ++s) {
+        if (cells.seq_pos_min(s) >= 0) {
+            return plan;
+        }
+    }
+
+    const llama_pos pmin = cells.seq_pos_min(0);
+    const llama_pos pmax = cells.seq_pos_max(0);
+    if (pmin != 0 || (int64_t) cells.get_used() != (int64_t) pmax + 1) {
+        return plan;
+    }
+
+    const int64_t r      = ratio;
+    // complete blocks only: the trailing partial block keeps whatever the cache row held until its
+    // last cell arrives, so up to ratio-1 newest positions are scored against a stale block key
+    const int64_t n_full = ((int64_t) pmax + 1)/r;
+    const int64_t valid  = std::min<int64_t>(n_full, qsa_valid[ratio]);
+    const int64_t n_pad  = (int64_t) ubatch.n_tokens/r + 2;
+
+    plan.use = true;
+    if (n_full - valid > n_pad) {
+        plan.refresh = true;
+    } else {
+        plan.n_upd = n_pad;
+    }
+
+
+    return plan;
+}
+
+void llama_memory_hybrid_idx::qsa_set_input(const qsa_cache_plan & plan, ggml_tensor * upd_blk, ggml_tensor * upd_cells,
+        ggml_tensor * upd_pos, uint32_t ratio) const {
+    GGML_ASSERT(plan.use);
+
+    const auto & cells = mem_idx->get_cells(0);
+    const int64_t r      = ratio;
+    const int64_t n_full = ((int64_t) cells.seq_pos_max(0) + 1)/r;
+
+    if (plan.refresh) {
+        qsa_valid[ratio] = n_full;
+        return;
+    }
+
+    // position -> cell for the blocks being written
+    const int64_t valid = std::min<int64_t>(n_full, qsa_valid[ratio]);
+    const int64_t n_new = n_full - valid;
+    GGML_ASSERT(n_new <= plan.n_upd);
+
+    std::vector<int32_t> cell_of_pos;
+    const int64_t p_lo = std::max<int64_t>(0, std::min<int64_t>(valid, n_full - 1))*r;
+    const int64_t p_hi = std::max<int64_t>(n_full, 1)*r;
+    cell_of_pos.assign(p_hi - p_lo, 0);
+    for (uint32_t j = 0; j < cells.size(); ++j) {
+        if (cells.is_empty(j)) {
+            continue;
+        }
+        const llama_pos p = cells.pos_get(j);
+        if (p >= p_lo && p < p_hi) {
+            cell_of_pos[p - p_lo] = (int32_t) j;
+        }
+    }
+
+    int32_t * blk  = (int32_t *) upd_blk->data;
+    int32_t * cel  = (int32_t *) upd_cells->data;
+    int32_t * pos4 = (int32_t *) upd_pos->data;
+
+    for (int64_t i = 0; i < plan.n_upd; ++i) {
+        // padding rewrites the last valid block, or row 0 when there is none
+        int64_t b = i < n_new ? valid + i : std::max<int64_t>(0, std::min<int64_t>(valid, n_full) + n_new - 1);
+        if (n_full == 0) {
+            b = 0;
+        }
+        blk[i] = (int32_t) b;
+        for (int64_t k = 0; k < r; ++k) {
+            const int64_t p = b*r + k;
+            cel[i*r + k] = (p >= p_lo && p < p_hi) ? cell_of_pos[p - p_lo] : 0;
+        }
+        for (int64_t sec = 0; sec < 4; ++sec) {
+            pos4[sec*plan.n_upd + i] = (int32_t) (b*r);
+        }
+    }
+
+    qsa_valid[ratio] = n_full;
+}
