+void llama_memory_hybrid_idx::qsa_invalidate(llama_pos p0) {
+    for (auto & [ratio, valid] : qsa_valid) {
+        valid = std::min<int64_t>(valid, p0/(llama_pos) ratio);
+    }
+}
