diff --git a/ggml/src/ggml-cuda/hc-fuse.cu b/ggml/src/ggml-cuda/hc-fuse.cu
new file mode 100644
index 000000000..4eea71101
--- /dev/null
+++ b/ggml/src/ggml-cuda/hc-fuse.cu
@@ -0,0 +1,75 @@
+#include "hc-fuse.cuh"
+
+#define HC_FUSE_BLOCK_SIZE 256
+
+// The element order of every operation below mirrors the unfused graph exactly, and every
+// arithmetic step uses an intrinsic so the compiler cannot contract a mul+add into an fma.
+
+static __global__ void hc_mix_reduce_f32(
+        const float * __restrict__ xn, const float * __restrict__ gate, float * __restrict__ dst,
+        const int n_embd, const int hc, const int64_t n_elem, const float scale) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n_elem) {
+        return;
+    }
+    const int     e = i % n_embd;
+    const int64_t t = i / n_embd;
+
+    const float * x = xn   + t*n_embd*hc;
+    const float * g = gate + t*n_embd*hc;
+
+    float acc = __fmul_rn(x[e], g[e]);
+    for (int c = 1; c < hc; ++c) {
+        acc = __fadd_rn(acc, __fmul_rn(x[c*n_embd + e], g[c*n_embd + e]));
+    }
+    dst[i] = __fmul_rn(acc, scale);
+}
+
+static __global__ void hc_combine_f32(
+        const float * __restrict__ res, const float * __restrict__ bo,
+        const float * __restrict__ inj, float * __restrict__ dst,
+        const int n_embd, const int hc, const int64_t n_elem,
+        const int64_t res_s1, const int64_t res_s2, const int64_t bo_s1, const int64_t bo_s2,
+        const int64_t dst_s1, const int64_t dst_s2, const float wscale) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n_elem) {
+        return;
+    }
+    const int     e = i % n_embd;
+    const int     c = (i / n_embd) % hc;
+    const int64_t t = i / ((int64_t) n_embd * hc);
+
+    const float w = __fmul_rn(1.0f / (1.0f + expf(-inj[t*hc + c])), wscale);
+    dst[t*dst_s2 + c*dst_s1 + e] = __fadd_rn(res[t*res_s2 + c*res_s1 + e], __fmul_rn(bo[t*bo_s2 + c*bo_s1 + e], w));
+}
+
+void ggml_cuda_op_hc_mix_reduce(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * xn, const ggml_tensor * gate, ggml_tensor * dst, int hc, float scale) {
+    const int     n_embd = dst->ne[0];
+    const int64_t n_elem = ggml_nelements(dst);
+    const int64_t nblk   = (n_elem + HC_FUSE_BLOCK_SIZE - 1) / HC_FUSE_BLOCK_SIZE;
+
+    const ggml_cuda_kernel_launch_params launch_params(dim3(nblk, 1, 1), dim3(HC_FUSE_BLOCK_SIZE, 1, 1), 0, ctx.stream());
+    ggml_cuda_kernel_launch(hc_mix_reduce_f32, launch_params,
+            (const float *) xn->data, (const float *) gate->data, (float *) dst->data,
+            n_embd, hc, n_elem, scale);
+}
+
+void ggml_cuda_op_hc_combine(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * residual, const ggml_tensor * block_out, const ggml_tensor * inject,
+        ggml_tensor * dst, float wscale, bool bo_has_hc) {
+    const int     n_embd = dst->ne[0];
+    const int     hc     = dst->ne[1];
+    const int64_t n_elem = ggml_nelements(dst);
+    const int64_t nblk   = (n_elem + HC_FUSE_BLOCK_SIZE - 1) / HC_FUSE_BLOCK_SIZE;
+
+    const ggml_cuda_kernel_launch_params launch_params(dim3(nblk, 1, 1), dim3(HC_FUSE_BLOCK_SIZE, 1, 1), 0, ctx.stream());
+    ggml_cuda_kernel_launch(hc_combine_f32, launch_params,
+            (const float *) residual->data, (const float *) block_out->data,
+            (const float *) inject->data, (float *) dst->data,
+            n_embd, hc, n_elem,
+            (int64_t) (residual->nb[1]/sizeof(float)), (int64_t) (residual->nb[2]/sizeof(float)),
+            bo_has_hc ? (int64_t) (block_out->nb[1]/sizeof(float)) : (int64_t) 0,
+            bo_has_hc ? (int64_t) (block_out->nb[2]/sizeof(float)) : (int64_t) n_embd,
+            (int64_t) (dst->nb[1]/sizeof(float)), (int64_t) (dst->nb[2]/sizeof(float)), wscale);
+}
