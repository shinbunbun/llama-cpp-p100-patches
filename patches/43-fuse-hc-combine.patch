+// The fused kernels read their sources while writing the output, so a source the allocator has
+// recycled into the output's buffer would be clobbered. Element-wise aliasing at the same index
+// (the in-place ADD the allocator likes to make) stays safe and is allowed separately.
+static bool ggml_cuda_hc_overlaps(const ggml_tensor * a, const ggml_tensor * b) {
+    if (!a || !b || !a->data || !b->data || !a->buffer || !b->buffer) {
+        return true;
+    }
+    const char * as = (const char *) a->data;
+    const char * ae = as + ggml_backend_buft_get_alloc_size(a->buffer->buft, a);
+    const char * bs = (const char *) b->data;
+    const char * be = bs + ggml_backend_buft_get_alloc_size(b->buffer->buft, b);
+    return as < be && bs < ae;
+}
+
+// Every node the two hyper-connection fusions elide must be consumed only inside the matched
+// range, otherwise skipping its write would change what a later node reads.
+static bool ggml_cuda_hc_range_self_contained(const ggml_cgraph * cgraph, int first, int last) {
+    for (int j = first; j <= last; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (!ggml_cuda_is_view_or_noop(n) && (n->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            return false;
+        }
+        if (j == last) {
+            break;
+        }
+        if (n->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return false;
+        }
+        int32_t uses = 0;
+        for (int k = first; k <= last; ++k) {
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                uses += cgraph->nodes[k]->src[s] == n;
+            }
+        }
+        if (uses != ggml_node_get_use_count(cgraph, j)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// MUL(xn, gate) -> ADD chain over the hc stream views -> SCALE(1/hc)
+static int ggml_cuda_try_hc_mix_fusion(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i, bool dry) {
+    const ggml_tensor * mul = cgraph->nodes[i];
+    if (mul->op != GGML_OP_MUL || mul->src[0] == nullptr || mul->src[1] == nullptr) {
+        return 0;
+    }
+    const ggml_tensor * xn   = mul->src[0];
+    const ggml_tensor * gate = mul->src[1];
+    if (mul->type != GGML_TYPE_F32 || !ggml_is_contiguous(mul) ||
+        !ggml_are_same_shape(mul, xn) || !ggml_are_same_shape(mul, gate) ||
+        xn->type != GGML_TYPE_F32 || gate->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(xn) || !ggml_is_contiguous(gate) || mul->ne[2] != 1 || mul->ne[3] != 1) {
+        return 0;
+    }
+
+    const int64_t hc_dim = mul->ne[0];
+    const int64_t nt     = mul->ne[1];
+
+    std::vector<const ggml_tensor *> adds;
+    const ggml_tensor * scale = nullptr;
+    int last = i;
+    for (int j = i + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        if (n->op == GGML_OP_ADD) {
+            adds.push_back(n);
+            last = j;
+            continue;
+        }
+        if (n->op == GGML_OP_SCALE && !adds.empty()) {
+            scale = n;
+            last  = j;
+        }
+        break;
+    }
+    if (scale == nullptr || adds.empty() || scale->src[0] != adds.back()) {
+        return 0;
+    }
+
+    const int64_t hc     = (int64_t) adds.size() + 1;
+    const int64_t n_embd = hc_dim / hc;
+    if (n_embd * hc != hc_dim || scale->type != GGML_TYPE_F32 || !ggml_is_contiguous(scale) ||
+        scale->ne[0] != n_embd || scale->ne[1] != nt || scale->ne[2] != 1 || scale->ne[3] != 1) {
+        return 0;
+    }
+
+    float sp[2] = { 0.0f, 0.0f };
+    memcpy(sp, scale->op_params, sizeof(sp));
+    if (sp[1] != 0.0f || sp[0] != 1.0f / (float) hc) {
+        return 0;
+    }
+
+    // each ADD folds in stream c as a [n_embd, nt] view of the MUL result at offset c
+    const size_t row = ggml_row_size(GGML_TYPE_F32, n_embd);
+    for (int64_t c = 1; c < hc; ++c) {
+        const ggml_tensor * a  = adds[c - 1];
+        const ggml_tensor * s0 = a->src[0];
+        const ggml_tensor * s1 = a->src[1];
+        if (a->type != GGML_TYPE_F32 || a->ne[0] != n_embd || a->ne[1] != nt ||
+            s1->type != GGML_TYPE_F32 || s1->ne[0] != n_embd || s1->ne[1] != nt ||
+            s1->nb[1] != row * hc || (const char *) s1->data != (const char *) mul->data + row * c) {
+            return 0;
+        }
+        const bool s0_ok = c == 1
+            ? (s0->ne[0] == n_embd && s0->ne[1] == nt && s0->nb[1] == row * hc && s0->data == mul->data)
+            : (s0 == adds[c - 2]);
+        if (!s0_ok) {
+            return 0;
+        }
+    }
+
+    if (!ggml_cuda_hc_range_self_contained(cgraph, i, last)) {
+        return 0;
+    }
+    if (ggml_cuda_hc_overlaps(scale, xn) || ggml_cuda_hc_overlaps(scale, gate)) {
+        return 0;
+    }
+
+    if (!dry) {
+        ggml_cuda_op_hc_mix_reduce(*cuda_ctx, xn, gate, cgraph->nodes[last], (int) hc, sp[0]);
+    }
+    return last - i;
+}
+
+// REPEAT(block_out) -> SIGMOID(inject) -> SCALE(2) -> MUL -> ADD(residual, .)
+static int ggml_cuda_try_hc_combine_fusion(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * rep = cgraph->nodes[i];
+    const ggml_tensor * bo  = rep->src[0];
+    if (rep->type != GGML_TYPE_F32 || bo->type != GGML_TYPE_F32 || !ggml_is_contiguous(bo) ||
+        rep->ne[3] != 1 || bo->ne[0] != rep->ne[0] || ggml_nelements(bo) != rep->ne[0]*rep->ne[2]) {
+        return 0;
+    }
+
+    const ggml_tensor * chain[4] = { nullptr, nullptr, nullptr, nullptr };
+    int last = i;
+    int got  = 0;
+    for (int j = i + 1; j < cgraph->n_nodes && got < 4; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        static const ggml_op want[4] = { GGML_OP_UNARY, GGML_OP_SCALE, GGML_OP_MUL, GGML_OP_ADD };
+        if (n->op != want[got] || (got == 0 && ggml_get_unary_op(n) != GGML_UNARY_OP_SIGMOID)) {
+            return 0;
+        }
+        chain[got++] = n;
+        last = j;
+    }
+    if (got != 4) {
+        return 0;
+    }
+
+    const ggml_tensor * sig = chain[0];
+    const ggml_tensor * sc  = chain[1];
+    const ggml_tensor * mul = chain[2];
+    const ggml_tensor * add = chain[3];
+    const ggml_tensor * inj = sig->src[0];
+    const ggml_tensor * res = add->src[0];
+
+    float sp[2] = { 0.0f, 0.0f };
+    memcpy(sp, sc->op_params, sizeof(sp));
+    if (sc->src[0] != sig || sp[1] != 0.0f || sig->type != GGML_TYPE_F32 ||
+        inj->type != GGML_TYPE_F32 || !ggml_is_contiguous(inj) || !ggml_is_contiguous(sig)) {
+        return 0;
+    }
+    if (mul->src[0] != rep || mul->src[1]->data != sc->data || add->src[1] != mul ||
+        add->type != GGML_TYPE_F32 || res->type != GGML_TYPE_F32 ||
+        !ggml_are_same_shape(add, res) || !ggml_are_same_shape(add, rep) || add->ne[3] != 1) {
+        return 0;
+    }
+
+    const int64_t hc = add->ne[1];
+    const int64_t nt = add->ne[2];
+    // hc_combine_f32 indexes the weight as [1, hc, nt]; ggml_mul would also admit [hc, 1, nt]
+    if (mul->src[1]->ne[0] != 1 || mul->src[1]->ne[1] != hc || mul->src[1]->ne[2] != nt) {
+        return 0;
+    }
+    if (inj->ne[0] != hc || ggml_nelements(inj) != hc*nt) {
+        return 0;
+    }
+
+    if (!ggml_cuda_hc_range_self_contained(cgraph, i, last)) {
+        return 0;
+    }
+
+    if (ggml_cuda_hc_overlaps(add, bo) || ggml_cuda_hc_overlaps(add, inj) ||
+        (ggml_cuda_hc_overlaps(add, res) && !(res->data == add->data && ggml_are_same_stride(res, add)))) {
+        return 0;
+    }
+
+    ggml_cuda_op_hc_combine(*cuda_ctx, res, bo, inj, cgraph->nodes[last], sp[0], false);
+    return last - i;
+}
+
+// SIGMOID(inject) -> SCALE(2) -> MUL(repeat(block_out), .) -> ADD(residual, .)
+// The REPEAT is left in place: graph order puts the inject matmul between it and the SIGMOID,
+// so it is already executed by the time this fires.
+static int ggml_cuda_try_hc_combine_from_sigmoid(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * sig = cgraph->nodes[i];
+    const ggml_tensor * inj = sig->src[0];
+    if (sig->type != GGML_TYPE_F32 || inj == nullptr || inj->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(sig) || !ggml_is_contiguous(inj)) {
+        return 0;
+    }
+
+    const ggml_tensor * chain[3] = { nullptr, nullptr, nullptr };
+    int last = i;
+    int got  = 0;
+    for (int j = i + 1; j < cgraph->n_nodes && got < 3; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        static const ggml_op want[3] = { GGML_OP_SCALE, GGML_OP_MUL, GGML_OP_ADD };
+        if (n->op != want[got]) {
+            return 0;
+        }
+        chain[got++] = n;
+        last = j;
+    }
+    if (got != 3) {
+        return 0;
+    }
+
+    const ggml_tensor * sc  = chain[0];
+    const ggml_tensor * mul = chain[1];
+    const ggml_tensor * add = chain[2];
+    const ggml_tensor * rep = mul->src[0];
+    const ggml_tensor * res = add->src[0];
+
+    float sp[2] = { 0.0f, 0.0f };
+    memcpy(sp, sc->op_params, sizeof(sp));
+    if (sc->src[0] != sig || sp[1] != 0.0f || mul->src[1]->data != sc->data || add->src[1] != mul ||
+        rep == nullptr || rep->op != GGML_OP_REPEAT || rep->type != GGML_TYPE_F32) {
+        return 0;
+    }
+
+    // the pre-repeat tensor dies at the REPEAT, so by now its buffer may hold something else
+    const ggml_tensor * bo = rep;
+    if (add->type != GGML_TYPE_F32 || res->type != GGML_TYPE_F32 ||
+        !ggml_are_same_shape(add, res) || !ggml_are_same_shape(add, rep) || add->ne[3] != 1) {
+        return 0;
+    }
+
+    const int64_t hc = add->ne[1];
+    const int64_t nt = add->ne[2];
+    // hc_combine_f32 indexes the weight as [1, hc, nt]; ggml_mul would also admit [hc, 1, nt]
+    if (mul->src[1]->ne[0] != 1 || mul->src[1]->ne[1] != hc || mul->src[1]->ne[2] != nt) {
+        return 0;
+    }
+    if (inj->ne[0] != hc || ggml_nelements(inj) != hc*nt) {
+        return 0;
+    }
+
+    if (!ggml_cuda_hc_range_self_contained(cgraph, i, last)) {
+        return 0;
+    }
+
+    const auto inplace_ok = [&](const ggml_tensor * src) {
+        return !ggml_cuda_hc_overlaps(add, src) ||
+               (src->data == add->data && ggml_are_same_stride(src, add));
+    };
+    if (ggml_cuda_hc_overlaps(add, inj) || !inplace_ok(bo) || !inplace_ok(res)) {
+        return 0;
+    }
+
+    ggml_cuda_op_hc_combine(*cuda_ctx, res, bo, inj, cgraph->nodes[last], sp[0], true);
+    return last - i;
+}
+
 // try and fuse nodes and return the number of nodes to skip
