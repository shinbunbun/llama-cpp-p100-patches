+// build_qsa_sel + build_attn_qsa with the selected cells gathered per query instead of masking a dense
+// attention. Every step is row-wise in the query, so the queries are processed in chunks and no tensor
+// spans n_pool or n_kv by n_tokens.
+ggml_tensor * llama_model_qwen4exp::graph::build_attn_qsa_sparse(
+        llm_graph_input_attn_kv *               inp,
+        const llama_memory_hybrid_idx_context * mctx_hyb,
+        llm_graph_input_kpool *                 inp_kpool,
+        ggml_tensor *                           cur,
+        ggml_tensor *                           q_cur,
+        ggml_tensor *                           k_cur,
+        ggml_tensor *                           v_cur,
+        ggml_tensor *                           inp_pos,
+        int *                                   sections,
+        float                                   kq_scale,
+        int                                     il) {
+    const auto * mctx_cur = inp->mctx;
+
+    const int64_t idx_dim    = hparams.indexer_head_size;
+    const int64_t n_idx_h    = hparams.indexer_n_head;
+    const int64_t kpool      = inp_kpool->kpool;
+    const int64_t n_pool     = inp_kpool->pool_cells->ne[0];
+    const int64_t n_kv       = inp_kpool->n_kv;
+    const int64_t n_sel      = inp_kpool->n_sel;
+
+    const int64_t width_fa = qwen4exp_qsa_pad() && n_sel >= 256 ? GGML_PAD(n_sel, 256) : n_sel;
+
+    ggml_tensor * q_idx  = nullptr;
+    ggml_tensor * pooled = build_qsa_index(mctx_hyb, inp_kpool, cur, inp_pos, sections, il, &q_idx);
+
+    q_cur = build_qsa_store(inp, q_cur, k_cur, v_cur, il);
+
+    ggml_tensor * kq_mask = inp->get_kq_mask();
