+        }
+        parts.swap(next);
+    }
+    ggml_tensor * out = parts[0];
+    cb(out, "kqv_out", il);
+
+    if (inp->self_v_rot) {
+        out = llama_mul_mat_hadamard(ctx0, out, inp->self_v_rot);
+    }
+
+    return out;
+}
