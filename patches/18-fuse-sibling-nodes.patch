+// Recover the index of the last accepted node after nodes[] has been compacted
+static int ggml_cuda_node_index_of(const ggml_cgraph * cgraph, int from, const ggml_tensor * t) {
+    for (int j = from; j < cgraph->n_nodes; ++j) {
+        if (cgraph->nodes[j] == t) {
+            return j;
+        }
+    }
+    return from;
+}
