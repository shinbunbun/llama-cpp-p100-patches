+int ggml_cuda_rms_norm_scale_fused(ggml_backend_cuda_context & ctx, ggml_tensor ** rms, ggml_tensor ** scl, int n) {
+    if (n < 1 || n > CUDA_RMS_SCALE_FUSE_MAX) {
+        return 0;
+    }
+
+    const ggml_tensor * src0 = rms[0]->src[0];
+    const size_t ts0 = sizeof(float);
+
+    auto matches = [&](int k) {
+        const ggml_tensor * s = rms[k]->src[0];
+        if (!s || s->type != GGML_TYPE_F32 || rms[k]->type != GGML_TYPE_F32 || scl[k]->type != GGML_TYPE_F32) {
+            return false;
+        }
+        if (scl[k]->src[0] != rms[k] || !ggml_is_contiguous(rms[k]) || !ggml_is_contiguous(scl[k]) || s->nb[0] != ts0) {
+            return false;
+        }
+        if (memcmp(rms[k]->op_params, rms[0]->op_params, sizeof(float)) != 0) {
+            return false;
+        }
+        for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+            if (s->ne[i] != src0->ne[i] || s->nb[i] != src0->nb[i] || scl[k]->ne[i] != src0->ne[i]) {
+                return false;
+            }
+        }
+        return true;
+    };
+    int m = 0;
+    while (m < n && matches(m)) {
+        ++m;
+    }
+    n = m;
+    if (n == 0) {
+        return 0;
+    }
+
+    const int64_t ncols     = src0->ne[0];
+    const int64_t nrows     = src0->ne[1];
+    const int64_t nchannels = src0->ne[2];
+    const int64_t nsamples  = src0->ne[3];
+
+    // the 1024-wide instantiation caches the row in registers; the unfused path would pick it here
+    if (ncols >= 1024 || nrows*n > INT_MAX) {
+        return 0;
+    }
+
+    rms_norm_scale_fused_args p = {};
+    for (int k = 0; k < n; ++k) {
+        p.x[k]   = (const float *) rms[k]->src[0]->data;
+        p.dst[k] = (float *)       scl[k]->data;
+        memcpy(&p.scale[k], (const float *) scl[k]->op_params + 0, sizeof(float));
+        memcpy(&p.bias[k],  (const float *) scl[k]->op_params + 1, sizeof(float));
+    }
+    p.nrows = (int) nrows;
+
+    float eps;
+    memcpy(&eps, rms[0]->op_params, sizeof(float));
+
+    const dim3 blocks_num((unsigned int) (nrows*n), (unsigned int) nchannels, (unsigned int) nsamples);
+    const dim3 block_dims(256, 1, 1);
+    const ggml_cuda_kernel_launch_params launch_params = {blocks_num, block_dims, 32 * sizeof(float), ctx.stream()};
+    ggml_cuda_kernel_launch(rms_norm_scale_pairs_f32<256>, launch_params,
+        p, (int) ncols, (int64_t) (src0->nb[1]/ts0), (int64_t) (src0->nb[2]/ts0), (int64_t) (src0->nb[3]/ts0), eps);
+
+    return n;
+}
