+        return VARS_TO_STR6(head_dim, n_head, n_tokens, n_pairs, bias, inplace);
+    }
+
+    test_rms_norm_scale_pairs(int64_t head_dim = 128, int64_t n_head = 16, int64_t n_tokens = 1, int n_pairs = 2,
+            float bias = 0.0f, bool inplace = false)
+        : head_dim(head_dim), n_head(n_head), n_tokens(n_tokens), n_pairs(n_pairs), bias(bias), inplace(inplace) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t row = head_dim * n_head * (n_pairs + 1);
+        ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, row, n_tokens);
+        ggml_set_param(x);
+        ggml_set_name(x, "x");
+        x = ggml_exp(ctx, x);
+
+        // the sum is nested to the right so that every pair is computed before any ADD
+        ggml_tensor * out = nullptr;
+        for (int k = 0; k < n_pairs; ++k) {
+            ggml_tensor * v = ggml_view_3d(ctx, x, head_dim, n_head, n_tokens,
